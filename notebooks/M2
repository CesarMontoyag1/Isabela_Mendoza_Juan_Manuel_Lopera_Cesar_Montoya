        "def make_baseline_system(system: Dict[str, Any],\n",
        "                         max_new_tokens: int = 128) -> Dict[str, Any]:\n",
        "    \"\"\"Crea el sistema 'baseline' (zero-shot): el MISMO modelo ya cargado pero con el\n",
        "    adaptador LoRA DESACTIVADO durante la generación (peft `disable_adapter`).\n",
        "\n",
        "    Así el baseline del README (Qwen2.5-1.5B-Instruct sin fine-tuning, ~20% exact-match)\n",
        "    se evalúa SIN cargar un segundo modelo: el coste extra de RAM es ~0, ideal para free\n",
        "    Colab. En modo demo (sin modelo real) devuelve el propio system.\n",
        "    \"\"\"\n",
        "    modo = system.get(\"modo\", \"real\")\n",
        "    model = system.get(\"model\")\n",
        "    if modo != \"real\" or model is None or not hasattr(model, \"disable_adapter\"):\n",
        "        print(\"[harness] Baseline = sistema actual (no hay modelo real con adaptador).\")\n",
        "        return system\n",
        "\n",
        "    import torch\n",
        "    tokenizer = system[\"tokenizer\"]\n",
        "    device = next(model.parameters()).device\n",
        "\n",
        "    def model_chat(mensajes, max_new_tokens=max_new_tokens):\n",
        "        # peft>=0.13.2: disable_adapter() es un CONTEXT MANAGER que apaga la LoRA\n",
        "        # dentro del bloque `with` y la reactiva automáticamente al salir (en esta\n",
        "        # versión NO existe enable_adapter()).\n",
        "        with model.disable_adapter():\n",
        "            texto = tokenizer.apply_chat_template(mensajes, tokenize=False, add_generation_prompt=True)\n",
        "            inputs = tokenizer(texto, return_tensors=\"pt\").to(device)\n",
        "            with torch.no_grad():\n",
        "                out = model.generate(\n",
        "                    **inputs, max_new_tokens=max_new_tokens,\n",
        "                    pad_token_id=tokenizer.pad_token_id, eos_token_id=tokenizer.eos_token_id,\n",
        "                )\n",
        "            return tokenizer.decode(out[0][inputs[\"input_ids\"].shape[1]:], skip_special_tokens=True)\n",
        "\n",
        "    def generate(mensaje_user: str, system_prompt: str = SYSTEM_PROMPT) -> str:\n",
        "        return model_chat([\n",
        "            {\"role\": \"system\", \"content\": system_prompt},\n",
        "            {\"role\": \"user\", \"content\": mensaje_user},\n",
        "        ])\n",
        "\n",
        "    print(\"[harness] Baseline zero-shot listo (LoRA desactivada durante la generación).\")\n",
        "    return {\"model\": model, \"tokenizer\": tokenizer, \"generate\": generate, \"model_chat\": model_chat,\n",
        "            \"modo\": \"baseline\", \"lora_cargada\": system.get(\"lora_cargada\", False)}"
      ]
    },
